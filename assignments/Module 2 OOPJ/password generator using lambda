package functional;
import java.util.Random;

import java.util.function.Supplier;

public class otpgenerator {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		Supplier<String> obj=()->{
			char []arr= {'A','E','I','O','U'};
			Random r=new Random();
			char v=arr[r.nextInt(arr.length)];
			int d=r.nextInt(1000,9999);
			char vv=arr[r.nextInt(arr.length)];
			return v+""+d+""+vv;			
			
		};
		System.out.println("password is : "+obj.get());
		

	}

}
