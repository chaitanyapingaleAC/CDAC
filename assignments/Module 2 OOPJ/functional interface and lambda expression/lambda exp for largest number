package functional;

import program.consoleinput;

@FunctionalInterface
interface Largest{
	int large(int []arr);
}

public class largestnumberlamda {

	public static void main(String[] args) {
		// TODO Auto-generated method stub


		int []arr=new int[5];
		
		Largest objlargest=(a)->{
			System.out.println("enter the elements in array upto 5");
			for(int itemp=0;itemp<a.length;itemp++) {
				a[itemp]=consoleinput.getint();
			}
			int max=0;
			for(int itemp=0;itemp<a.length;itemp++) {
				if(a[itemp]>max)
					max=a[itemp];
				
			}
			return max;
		};
		
		System.out.println("largest element is : "+objlargest.large(arr));



		int []arr= {2,5,4,8,1,5};
		
		
		//using function
		
		Function<int[],Integer> fobj=(int []s)->{
			
			int max=0;
			for(int itemp=0;itemp<s.length;itemp++) {
				if(s[itemp]>max)
					max=s[itemp];
			}
			return max;
		};
		int a=fobj.apply(arr);
		System.out.println(a);
		
		
		
		
	}

}
